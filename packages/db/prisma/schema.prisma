generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

//
// ==========================
// AUTH & USERS
// ==========================
//

enum Role {
  USER
  ADMIN
}

model User {
  id    String @id @default(uuid())
  email String @unique

  name          String?
  role          Role    @default(USER)
  emailVerified Boolean @default(false)
  image         String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  listings Listing[]

  messages             Message[]      @relation("UserMessages")
  conversationsAsUser1 Conversation[] @relation("ConversationUser1")
  conversationsAsUser2 Conversation[] @relation("ConversationUser2")

  savedSearches     SavedSearch[]
  notifications     Notification[]
  bookmarks         Bookmark[]
  pushSubscriptions PushSubscription[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id         String @id @default(uuid())
  accountId  String
  providerId String

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  purpose    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("verification")
}

//
// ==========================
// CATEGORIES & PRODUCTS
// ==========================
//

model Category {
  id   String @id @default(uuid())
  name String
  slug String

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  listings    Listing[] @relation("ListingCategory")
  subListings Listing[] @relation("ListingSubCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, parentId])
  @@index([parentId])
  @@map("category")
}

model Product {
  id         String   @id @default(uuid())
  name       String
  slug       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  listings Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, categoryId])
  @@index([categoryId])
  @@map("product")
}

//
// ==========================
// LISTINGS
// ==========================
//

enum PriceUnit {
  UNIT
  KG
  L
}

enum ListingStatus {
  ACTIVE
  ARCHIVED
  VERIFICATION
  REJECTED
}

model Listing {
  id String @id @default(uuid())

  title       String
  description String

  price     Float
  priceUnit PriceUnit

  status          ListingStatus @default(VERIFICATION)
  rejectionReason String?
  nsfwResults     Json?

  archivedAt DateTime?
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId       String
  categoryId    String
  subCategoryId String?
  productId     String?
  locationId    String

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category      Category       @relation("ListingCategory", fields: [categoryId], references: [id])
  subCategory   Category?      @relation("ListingSubCategory", fields: [subCategoryId], references: [id])
  product       Product?       @relation(fields: [productId], references: [id])
  location      Location       @relation(fields: [locationId], references: [id])
  images        ListingImage[]
  conversations Conversation[] @relation("ListingToConversation")
  bookmarks     Bookmark[]

  @@index([categoryId, status])
  @@index([locationId])
  @@index([createdAt])
  @@index([ownerId])
  @@map("listing")
}

enum ImageStatus {
  PENDING
  SAFE
  NSFW
}

model ListingImage {
  id        String  @id @default(uuid())
  listingId String
  url       String
  altText   String?
  index     Int

  status ImageStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, index])
  @@index([listingId])
  @@map("listing_image")
}

model Location {
  id String @id @default(uuid())

  city       String
  postalCode String
  lat        Float
  lng        Float
  coords     Unsupported("geography(Point, 4326)")?

  listings Listing[]

  createdAt DateTime @default(now())

  @@index([city, postalCode])
  @@index([lat, lng])
  @@index([coords], type: Gist)
  @@map("location")
}

//
// ==========================
// MESSAGING
// ==========================
//

model Conversation {
  id String @id @default(uuid())

  listingId String
  user1Id   String
  user2Id   String

  user1LastReadAt DateTime?
  user2LastReadAt DateTime?

  user1UnreadCount Int @default(0)
  user2UnreadCount Int @default(0)

  user1DeletedAt DateTime?
  user2DeletedAt DateTime?

  lastMessageAt       DateTime?
  lastMessagePreview  String?
  lastMessageSenderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation("ListingToConversation", fields: [listingId], references: [id], onDelete: Cascade)
  user1   User    @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2   User    @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  messages Message[]

  // App must enforce user1Id < user2Id ordering to prevent duplicate conversations
  @@unique([listingId, user1Id, user2Id])
  @@index([user1Id, lastMessageAt])
  @@index([user2Id, lastMessageAt])
  @@map("conversation")
}

model Message {
  id String @id @default(uuid())

  content String

  senderId       String
  conversationId String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("message")
}

//
// ==========================
// SAVED SEARCHES & NOTIFICATIONS
// ==========================
//

model SavedSearch {
  id     String @id @default(uuid())
  userId String
  title  String

  // Mirrors getListings()'s filter params — only the ones the browse page
  // actually exposes today (category is filtered by slug there, same here).
  query    String?
  category String?

  geoLat      Float?
  geoLng      Float?
  geoRadiusKm Float?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, title])
  @@index([userId])
  @@index([isActive, category])
  @@map("saved_search")
}

enum NotificationType {
  NEW_LISTING_MATCH
  LISTING_VALIDATED
  LISTING_REJECTED
  LISTING_ARCHIVED
}

model Notification {
  id     String           @id @default(uuid())
  userId String
  type   NotificationType

  listingId String
  payload   Json

  read Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per (user, listing, type): guards against duplicate notifications on
  // retry, and doubles as the upsert target so a repeat transition (e.g. a
  // listing archived, then unarchived, then archived again) refreshes the same
  // row to unread instead of piling up duplicates.
  @@unique([userId, listingId, type])
  @@index([userId, read])
  @@map("notification")
}

//
// ==========================
// BOOKMARKS
// ==========================
//

model Bookmark {
  userId    String
  listingId String

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
  @@map("bookmark")
}

//
// ==========================
// PUSH NOTIFICATIONS
// ==========================
//

model PushSubscription {
  id String @id @default(uuid())

  // Mirrors the browser's PushSubscription object exactly (endpoint +
  // keys.p256dh + keys.auth) so saving one is a direct field-for-field
  // copy, no reshaping. `endpoint` is unique per browser/device install —
  // re-subscribing the same device upserts this row rather than
  // duplicating it.
  endpoint String @unique
  p256dh   String
  auth     String

  // Informational only (shown in an account settings list of "notified
  // devices"), never used to identify a subscription.
  userAgent String?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}
