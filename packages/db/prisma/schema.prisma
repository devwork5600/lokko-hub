generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// ==========================
// AUTH & USERS
// ==========================
//

enum Role {
  USER
  ADMIN
}

model User {
  id    String @id @default(uuid())
  email String @unique

  name          String?
  role          Role    @default(USER)
  emailVerified Boolean @default(false)
  image         String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  listings Listing[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id         String @id @default(uuid())
  accountId  String
  providerId String

  accessToken           String?
  refreshToken          String?
  idToken                String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                  String?
  password               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  purpose    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("verification")
}

//
// ==========================
// CATEGORIES & PRODUCTS
// ==========================
//

model Category {
  id   String @id @default(uuid())
  name String
  slug String

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  listings    Listing[] @relation("ListingCategory")
  subListings Listing[] @relation("ListingSubCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, parentId])
  @@index([parentId])
  @@map("category")
}

model Product {
  id         String   @id @default(uuid())
  name       String
  slug       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  listings Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, categoryId])
  @@index([categoryId])
  @@map("product")
}

//
// ==========================
// LISTINGS
// ==========================
//

enum PriceUnit {
  UNIT
  KG
  L
}

enum ListingStatus {
  ACTIVE
  ARCHIVED
}

model Listing {
  id String @id @default(uuid())

  title       String
  description String

  price     Float
  priceUnit PriceUnit

  status ListingStatus @default(ACTIVE)

  archivedAt DateTime?
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId       String
  categoryId    String
  subCategoryId String?
  productId     String?
  locationId    String

  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category    Category  @relation("ListingCategory", fields: [categoryId], references: [id])
  subCategory Category? @relation("ListingSubCategory", fields: [subCategoryId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id])
  location    Location  @relation(fields: [locationId], references: [id])

  @@index([categoryId, status])
  @@index([locationId])
  @@index([createdAt])
  @@index([ownerId])
  @@map("listing")
}

// Deliberately minimal for now: just enough to attach a listing to a place.
// lat/lng/PostGIS coords land together with the geo-search slice, not before —
// no point half-wiring fields nothing reads yet.
model Location {
  id String @id @default(uuid())

  city       String
  postalCode String

  listings Listing[]

  createdAt DateTime @default(now())

  @@index([city, postalCode])
  @@map("location")
}
