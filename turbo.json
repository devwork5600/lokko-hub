{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "RESEND_API_KEY",
        "EMAIL_FROM"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "@lokko-hub/db#build": {
      // prisma generate writes the client into the root node_modules/@prisma/client,
      // outside this task's declared "dist/**" outputs. A cache hit here would skip
      // regenerating it, leaving a stale/ungenerated client behind. Always run fresh.
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "RESEND_API_KEY",
        "EMAIL_FROM"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
