# Database
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# App
NEXT_PUBLIC_URL=http://localhost:3000

# Authentication (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# Images (Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Moderation queue (BullMQ + Upstash Redis)
UPSTASH_REDIS_URL=
NSFW_API_URL=https://api.nsfw-protect.com
NSFW_API_KEY=

# Real-time (Socket.IO)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
SOCKET_INTERNAL_URL=http://localhost:3001
SOCKET_AUTH_SECRET=
SOCKET_BROADCAST_SECRET=

# Push notifications (Web Push / VAPID)
# Generate once with: npx web-push generate-vapid-keys
# Rotating these invalidates every existing push subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://lokkohub.com
